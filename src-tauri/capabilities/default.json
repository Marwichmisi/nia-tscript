{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/pcb-mcp",
          "sidecar": true,
          "args": ["serve", "--port", { "validator": "^[0-9]{2,5}$" }]
        }
      ]
    },
    {
      "identifier": "shell:allow-stdin-write",
      "allow": [{ "name": "binaries/pcb-mcp", "sidecar": true }]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [{ "name": "binaries/pcb-mcp", "sidecar": true }]
    }
  ]
}
