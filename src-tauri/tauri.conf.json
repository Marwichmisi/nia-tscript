{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nia-tscircuit-studio",
  "version": "0.1.0",
  "identifier": "dev.nia.tscircuit-studio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NIATSCIRCUIT Studio",
        "width": 900,
        "height": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/pcb-mcp"]
  }
}
